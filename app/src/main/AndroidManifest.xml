<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 局域网远控：提词端 WebSocket Server 与控制端 WebSocket Client 需要网络访问。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 读取当前活动网络以获取局域网 IPv4 地址。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 控制端扫码需要相机；仅在用户点击“扫码连接”后动态请求。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 相机不是应用必需硬件：无相机的设备仍可手动输入连接信息。 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".app.TeleprompterApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Teleprompter">
        <activity
            android:name=".testing.PlaybackGestureTestActivity"
            android:exported="false"
            android:theme="@style/Theme.Teleprompter" />
        <activity
            android:name=".testing.EditorInsetsTestActivity"
            android:exported="false"
            android:theme="@style/Theme.Teleprompter" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Teleprompter"
            android:windowSoftInputMode="adjustResize">
            <!-- API 36 otherwise ignores requested playback orientation on sw600dp+ displays. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
